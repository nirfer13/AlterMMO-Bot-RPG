# Skopiuj ten plik jako ".env" i uzupełnij wartości.

# Token bota z Discord Developer Portal
TOKEN=

# Baza produkcyjna (PostgreSQL)
DATABASE_URL=

# Baza testowa - używana tylko w trybie debug
HEROKU_POSTGRESQL_BRONZE_URL=

# 1 = tryb debug: kanał testowy, baza testowa, krótkie czasy respawnu
# (zastępuje dawny plik globals/globalvariables.py)
ALTERMMO_DEBUG=0
